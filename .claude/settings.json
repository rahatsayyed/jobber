{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(npx vitest run *)",
      "Bash(npx tsc *)",
      "mcp__n8n-mcp__n8n_get_workflow",
      "mcp__n8n-mcp__n8n_validate_workflow",
      "mcp__n8n-mcp__n8n_executions",
      "mcp__n8n-mcp__get_node",
      "mcp__job-fetch__search_jobs",
      "mcp__n8n-mcp__n8n_list_workflows",
      "mcp__sqlite__get_job_stats",
      "mcp__sqlite__get_outreach_stats"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Write|Edit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-outside-project.cjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__gmail__send_email|mcp__applier__(apply_(open|autofill|fill|choose|upload|next|submit|propose_recipe)|site_(login|signup|open_link))|mcp__linkedin__linkedin_(open|click|type|press_key|click_at|arm_send|resolve_external|search_jobs|search_posts|manual_job)|mcp__naukri__naukri_(open|click|type|press_key|click_at|arm_send|arm_apply|resolve_external|discover|manual_job)|mcp__wellfound__wellfound_(open|click|type|press_key|click_at|arm_send|arm_apply|resolve_external|discover|manual_job)|mcp__scout__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/kill-switch.cjs\"",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/settings-guard.cjs\"",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
