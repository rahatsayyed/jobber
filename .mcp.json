{
  "mcpServers": {
    "job-fetch": { "command": "npx", "args": ["tsx", "src/mcp/job-fetch.ts"] },
    "resume": { "command": "npx", "args": ["tsx", "src/mcp/resume.ts"] },
    "contacts": { "command": "npx", "args": ["tsx", "src/mcp/contacts.ts"] },
    "db": { "command": "npx", "args": ["tsx", "src/mcp/db.ts"] },
    "gates": { "command": "npx", "args": ["tsx", "src/mcp/gates.ts"] },
    "gmail": {
      "command": "npx",
      "args": ["-y", "@gongrzhe/server-gmail-autoauth-mcp"],
      "env": {
        "GMAIL_OAUTH_PATH": "secrets/gcp-oauth.keys.json",
        "GMAIL_CREDENTIALS_PATH": "secrets/gmail-credentials.json"
      }
    },
    "applier": { "command": "npx", "args": ["tsx", "src/mcp/applier.ts"] },
    "discover": { "command": "npx", "args": ["tsx", "src/mcp/discover.ts"] },
    "naukri": { "command": "npx", "args": ["tsx", "src/mcp/naukri.ts"] },
    "linkedin": { "command": "npx", "args": ["tsx", "src/mcp/linkedin.ts"] },
    "outreach": { "command": "npx", "args": ["tsx", "src/mcp/outreach.ts"] }
  }
}
