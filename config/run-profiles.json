{
  "version": 1,
  "profiles": {
    "outreach_wake": {
      "description": "Scheduled LinkedIn/Naukri wake: platform and db tools only, no secrets in env.",
      "mcp_config": "config/runner/mcp.platform.json",
      "builtin_tools": ["Skill", "Agent", "Task"],
      "allow": [
        "mcp__naukri__naukri_open", "mcp__naukri__naukri_state",
        "mcp__naukri__naukri_close", "mcp__naukri__naukri_screenshot",
        "mcp__db__list_queued_outreach", "mcp__db__get_funnel", "mcp__db__get_outreach_stats", "mcp__db__get_job_stats",
        "mcp__outreach__list_due_touches", "mcp__outreach__next_contacts", "mcp__outreach__record_inbound",
        "mcp__outreach__escalate", "mcp__outreach__list_open_escalations",
        "mcp__linkedin__linkedin_open", "mcp__linkedin__linkedin_state", "mcp__linkedin__linkedin_scroll",
        "mcp__linkedin__linkedin_click", "mcp__linkedin__linkedin_check_connection_status",
        "mcp__linkedin__linkedin_connect_send", "mcp__linkedin__linkedin_send_message",
        "mcp__naukri__naukri_search", "mcp__naukri__naukri_inbox", "mcp__naukri__naukri_read_thread",
        "mcp__naukri__naukri_send_message", "mcp__db__list_jobs", "mcp__db__update_outreach_status"
      ],
      "screen_args": [
        "mcp__outreach__escalate", "mcp__outreach__record_inbound",
        "mcp__linkedin__linkedin_send_message", "mcp__linkedin__linkedin_connect_send",
        "mcp__naukri__naukri_send_message", "mcp__linkedin__linkedin_open"
      ],
      "env_mode": "allowlist",
      "env_keys": [
        "TZ", "QUIET_HOURS_START", "QUIET_HOURS_END", "COMPANY_CONTACT_LIMIT", "SPECULATIVE_COMPANY_LIMIT",
        "JOBBER_RUN_ID", "JOBBER_DRY_RUN", "SCHEDULER_DRY_RUN", "LINKEDIN_DRY_RUN",
        "LINKEDIN_ALLOWED_URLS", "LINKEDIN_ALLOWED_EMAILS", "LINKEDIN_IDLE_MS", "LINKEDIN_ACCEPT_UNKNOWN"
      ],
      "env_prefixes": ["PACING_", "COOLDOWN_", "CADENCE_", "LINKEDIN_MAX_", "NAUKRI_MAX_", "CLASSIFIER_"],
      "output_format": "stream-json",
      "max_turns": 40
    },
    "hunt": {
      "description": "The existing hunt pipeline, without bypassPermissions.",
      "mcp_config": ".mcp.json",
      "builtin_tools": ["Skill", "Agent", "Task", "Read"],
      "allow_from_permission_set": "outreach_send",
      "path_rules": { "Read": { "prefixes": ["config/"] } },
      "screen_args": ["mcp__gmail__send_email", "mcp__linkedin__linkedin_connect_send", "mcp__linkedin__linkedin_send_message"],
      "env_mode": "dotenv_all",
      "env_files": [".env", ".env.ccr"],
      "max_turns": 200
    }
  }
}
