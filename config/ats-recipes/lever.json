{
  "schema": 1,
  "id": "lever",
  "platform": "lever",
  "verified": true,
  "source": "shipped",
  "note": "derived from the retired src/ats/lever.ts FieldMap; location and linkedin_url selectors added from the page layout and unverified",
  "steps": [
    {
      "id": "form",
      "kind": "form",
      "match": { "roles": ["name.full", "email", "resume"], "minFields": 3 },
      "fields": [
        { "role": "name.full", "selector": "input[name=\"name\"]", "type": "text", "required": true },
        { "role": "email", "selector": "input[name=\"email\"]", "type": "email", "required": true },
        { "role": "phone", "selector": "input[name=\"phone\"]", "type": "tel" },
        { "role": "location", "selector": "input[name=\"location\"]", "type": "text" },
        { "role": "linkedin_url", "selector": "input[name=\"urls[LinkedIn]\"]", "type": "text" },
        { "role": "resume", "selector": "input[name=\"resume\"]", "type": "file", "required": true },
        { "role": "cover_letter", "selector": "textarea[name=\"comments\"]", "type": "textarea" }
      ],
      "submit": { "selector": "button[type=\"submit\"]" }
    }
  ],
  "confirmation": { "roles_absent": ["email", "resume"] }
}
