# Copy this file to `.env` and fill in the values. `.env` is gitignored; this example is committed.

# --- Job sources ---
ADZUNA_APP_ID=                   # developer.adzuna.com
ADZUNA_APP_KEY=
SERPER_API_KEY=                  # serper.dev (dorks + contact search)

# --- Contact / email finder ---
HUNTER_API_KEY=                  # hunter.io (LAST resort only)
HUNTER_ENABLED=false             # keep false for first smoke test
HUNTER_MONTHLY_CAP=50            # hard cap on Hunter credits/month

# --- Email (Gmail via GongRzhe OAuth MCP) ---
# Put your Google OAuth client JSON at ./secrets/gcp-oauth.keys.json (gitignored).
# Token is written to ./secrets/gmail-credentials.json after running:
#   set -a; source .env; set +a; npx -y @gongrzhe/server-gmail-autoauth-mcp auth
GMAIL_OAUTH_PATH=./secrets/gcp-oauth.keys.json
GMAIL_CREDENTIALS_PATH=./secrets/gmail-credentials.json
# (legacy SMTP fallback — unused with GongRzhe)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- Telegram channel ---
# Telegram bridge (ccgram). One credentials file: keep these here with the other keys.
# The token comes from @BotFather.
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs, for example 123456789
ALLOWED_USERS=
# Leave CCGRAM_WHISPER_*, CCGRAM_LLM_*, CCGRAM_TTS_* and CCGRAM_MINIAPP_* unset (they stay off).
# Never add a skip-permissions flag anywhere in this project.

# --- Agent tuning ---
MATCH_THRESHOLD=60               # only pursue jobs scored >= this
SEND_LIMIT_PER_RUN=1             # cap real sends per run (raise once trusted)
MAX_APPLIES_PER_DAY=5            # cap real LinkedIn Easy Apply submissions per day (burner account)
MAX_LINKEDIN_SEARCHES_PER_DAY=20 # cap LinkedIn people-search lookups per day (main account)
ANTHROPIC_DEFAULT_OPUS_MODEL=deepseek/deepseek-v4-pro

# Local dashboard (npm run web). Sign-in is Google OIDC.
WEB_PORT=8787
WEB_TMUX_SESSION=ccgram
WEB_TMUX_WINDOW=JobApplier

# --- LinkedIn MCP typed tools (plan 6C) ---
LINKEDIN_DRY_RUN=true            # dry run is ON unless this is exactly the string false
LINKEDIN_ACCEPT_UNKNOWN=false    # true lets accept_invite accept senders not in the people table
LINKEDIN_MAX_ACCEPTS_PER_DAY=30  # daily cap on accepted invitations (integer 0..1000)
LINKEDIN_ALLOWED_URLS=           # comma-separated URLs outbound text may contain
LINKEDIN_ALLOWED_EMAILS=         # comma-separated emails outbound text may contain
LINKEDIN_IDLE_MS=600000          # close the browser after this idle time (60000..3600000)

# Dashboard sign-in (OIDC, one allowed account; plan 7C). `npm run setup` fills these.
DASHBOARD_ALLOWED_EMAIL=
WEB_OIDC_ISSUER=https://accounts.google.com
WEB_OIDC_CLIENT_ID=
WEB_OIDC_CLIENT_SECRET=
WEB_OIDC_REDIRECT_URI=http://127.0.0.1:8787/auth/callback
WEB_OIDC_REAUTH_PROMPT=select_account
WEB_REAUTH_MAX_AGE_SEC=300
WEB_AUTH_DB=.dashboard/auth.sqlite
# Listen address; loopback only unless WEB_ALLOW_REMOTE_BIND=true.
WEB_BIND=127.0.0.1
# Set true only to bind a non-loopback address on purpose.
WEB_ALLOW_REMOTE_BIND=false
# Comma list of extra Host values (tunnel hostnames), hostname or host:port.
WEB_ALLOWED_HOSTS=
# Set true only behind a trusted reverse proxy that sets forwarded headers.
WEB_TRUST_PROXY=false
# Set true to enable the two-step chat send (use a read_only permission set).
WEB_CHAT_ENABLED=false

# --- Scheduler (plan 6D). Dry run is the default: live needs every dry flag explicitly false. ---
SCHEDULER_ENABLED=true           # false makes the daemon exit at start
SCHEDULER_DRY_RUN=true           # dry unless exactly false (LINKEDIN_DRY_RUN must also be false to go live)
SCHEDULER_TMUX_SESSION=jobber-runs  # tmux session that holds the wake windows
SCHEDULER_NO_CLASSIFIER=false    # true skips the input classifier, honoured for dry runs only
# Tool-call, wall and token budgets are enforced by BudgetTracker from the stream-json output of the wake.
# Max turns is profile-owned (config/run-profiles.json max_turns), there is no env override.
RUN_MAX_TOOL_CALLS=60            # per-run tool call budget
RUN_MAX_WALL_SEC=900             # per-run wall clock budget in seconds
RUN_MAX_TOKENS_APPROX=150000     # per-run approximate token budget (stream characters / 4)
INBOX_EVERY_MIN=60               # minutes between recruiter inbox sweeps
NAUKRI_SEARCH_EVERY_HOURS=6      # hours between Naukri searches
USAGE_LIMIT_BACKOFF_MIN=300      # minutes to pause after the subscription usage limit
JOBBER_KILL=0                    # 1 stops every wake (same effect as .jobber/STOP)
JOBBER_NOTIFY_CMD=               # optional command run with the notice title as its only argument
AUTO_UPDATE=false                # true lets the scheduler run the auto-update tick (needs scripts/auto-update.ts)
BACKUP_ENABLED=false             # true lets the scheduler run the backup tick (needs scripts/backup.ts)

# --- Auto-update (plan 7D). Fast-forward only, signed commits, rollback on any failed step. See docs/backup-and-restore.md. ---
AUTO_UPDATE_REMOTE=origin        # git remote to fetch from (use the upstream remote, not a fork you cannot trust)
AUTO_UPDATE_BRANCH=main          # branch to fast-forward to
AUTO_UPDATE_TAG_PATTERN=         # optional tag glob (for example v*); empty follows the branch tip
AUTO_UPDATE_REQUIRE_SIGNED=true  # exactly false turns the signature check off (doctor warns)
AUTO_UPDATE_SIGNERS_FILE=        # allowed_signers file with the maintainer SSH public keys
AUTO_UPDATE_REVIEW_PATHS=        # comma list of paths that force a manual review; empty keeps the built-in list

# --- Encrypted backup (plan 7D). Needs age; the private key stays with the owner, never in .env. ---
BACKUP_DIR=                      # destination outside the project, ideally another disk (chmod 700)
BACKUP_AGE_RECIPIENT=            # age PUBLIC key (starts with age1); never a private key
BACKUP_INCLUDE_SECRETS=false     # true also archives secrets/ (OAuth tokens, browser sessions); see the runbook
BACKUP_RCLONE_REMOTE=            # optional rclone mirror, for example gdrive:jobber-backups
BACKUP_RETAIN_DAILY=7            # daily archives kept (integer 0..365)
BACKUP_RETAIN_WEEKLY=4           # weekly archives kept (integer 0..365)
BACKUP_RETAIN_MONTHLY=6          # monthly archives kept (integer 0..365)
