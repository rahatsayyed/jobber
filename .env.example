# Jobber environment file.
#
# GENERATED by `npm run env:example` from src/settings/envCatalog.ts. Do not edit it by hand: change the
# catalog and regenerate (`npm run env:example -- --check` fails on drift).
#
# Copy this file to `.env` (mode 600, gitignored) and fill in the values, or run `npm run setup`,
# which writes the values for you. `.env.example` itself is committed and holds no secrets.
#
# Format rules (every loader in this project reads the file the same way):
# - One `KEY=value` per line. Surrounding single or double quotes are stripped, nothing else.
# - NEVER put a comment after a value on the same line: the loaders read the inline comment as
#   part of the value, so `MATCH_THRESHOLD=60  # note` makes the limit invalid. Comments go on
#   their own line above the key.
# - A blank value (`KEY=`) means "not set". A commented-out line (`# KEY=value`) is an optional
#   setting that stays unset by default; the value shown is the code default.
# - Nothing here is sourced into a shell. Launchers parse the file and pass an allowlisted
#   environment to child processes.
# - Defaults, ranges and meanings of the numeric limits also live in src/setup/limitsCatalog.ts.

# =====================================================================================
# Credentials: job sources
# =====================================================================================

# Adzuna developer app id (developer.adzuna.com). Optional, enables the Adzuna job source (country
# in). Unset: Adzuna is skipped.
ADZUNA_APP_ID=
# Adzuna developer key. Optional, pairs with the app id. Unset: Adzuna is skipped. Secret.
ADZUNA_APP_KEY=

# =====================================================================================
# Credentials: contact finding (company domain and email lookup)
# =====================================================================================

# Serper search key (serper.dev). Optional, used for contact finding only, and only after the search
# cache and browser dorking miss, under the Serper budgets. Unset: Serper is never called. Secret.
SERPER_API_KEY=
# Hunter.io key (hunter.io). Optional, the last resort email source. Unset, or HUNTER_ENABLED not
# true: Hunter is never called. Secret.
HUNTER_API_KEY=
# Whether Hunter lookups are allowed. Keep false for the first smoke test. Hunter credits cost money
# beyond the plan. Default false. Allowed: true or false.
HUNTER_ENABLED=false
# Whether contact finding may search through the browser first (a dork). false: the cache, then
# Serper under budget. Default true. Allowed: true or false.
DORK_ENABLED=true
# Hours the browser dork stays off after a search engine blocks it. Default 24. Integer 0..720.
DORK_BLOCK_COOLDOWN_HOURS=24
# Days a search result is reused before it is searched again. A longer time saves Serper credits and
# shows older results. Default 14. Integer 0..365.
SEARCH_CACHE_TTL_DAYS=14
# Hunter.io credits spent per month on email lookups (last-resort source). Unit: per month. Needed
# only when HUNTER_ENABLED=true. Default 50. Integer 0..100000.
HUNTER_MONTHLY_CAP=50
# Serper searches per day for contact finding (reached only after the cache and browser dorking
# miss). Unit: per day. Default 20. Integer 0..100000.
SERPER_DAILY_BUDGET=20
# Serper searches per calendar month for contact finding. Unit: per month. Default 200. Integer
# 0..1000000.
SERPER_MONTHLY_BUDGET=200
# Browser search-engine lookups per day for contact finding. Unit: per day. Default 30. Integer
# 0..100000.
DORK_DAILY_BUDGET=30

# =====================================================================================
# Credentials: Gmail (cold email send and reply reading)
# =====================================================================================

# Google OAuth client keys file. Needed for email outreach and reply checks. Put the client JSON
# there; the login token is written to GMAIL_CREDENTIALS_PATH after the one-time auth command (see
# docs). Default ./secrets/gcp-oauth.keys.json.
GMAIL_OAUTH_PATH=./secrets/gcp-oauth.keys.json
# Where the Gmail login token is stored. Default ./secrets/gmail-credentials.json.
GMAIL_CREDENTIALS_PATH=./secrets/gmail-credentials.json
# Legacy SMTP address. Unused with the OAuth server. Optional, leave blank.
GMAIL_USER=
# Legacy SMTP app password. Unused with the OAuth server. Optional, leave blank. Secret.
GMAIL_APP_PASSWORD=

# =====================================================================================
# Safety and dry-run flags
# Any dry flag wins, and an unset flag counts as dry. Only the owner flips these.
# =====================================================================================

# Hunt-side dry run. 1 means dry (and the Gmail send hook denies gmail.send_email); anything else,
# such as 0, means this flag no longer forces dry. Live also needs SCHEDULER_DRY_RUN=false and, for
# LinkedIn paths, LINKEDIN_DRY_RUN=false. Default 1. Allowed: 1, 0.
JOBBER_DRY_RUN=1
# Scheduler dry run. Dry unless the value is exactly false. Live also needs LINKEDIN_DRY_RUN=false
# for LinkedIn paths. Default true. Allowed: true or false.
SCHEDULER_DRY_RUN=true
# LinkedIn typed tools dry run. Dry unless the value is exactly false. Default true. Allowed: true
# or false.
LINKEDIN_DRY_RUN=true
# Web dry run for company sites and ATS pages (login, sign-up, upload, typing, next and submit). Dry
# unless the value is exactly false. Live needs WEB_DRY_RUN, APPLY_DRY_RUN and SCOUT_DRY_RUN all
# false, plus SCHEDULER_DRY_RUN=false. Default true. Allowed: true or false.
WEB_DRY_RUN=true
# Browser applier dry run. Dry unless the value is exactly false. Default true. Allowed: true or
# false.
APPLY_DRY_RUN=true
# Source scout dry run. Dry unless the value is exactly false. Default true. Allowed: true or false.
SCOUT_DRY_RUN=true
# Kill switch. 1 stops every wake (same effect as the .jobber/STOP file); anything else is off.
# Prefer npm run jobber:control -- stop. Default 0. Allowed: 1, 0.
JOBBER_KILL=0
# Autonomous email follow-ups. false is legacy mode (10+ days quiet, max 2 per job, each approved on
# Telegram). true sends up to 3 follow-ups then a feedback message with no per-draft approval, on a
# clean reply check, under the shared daily send cap. Default false. Allowed: true or false.
FOLLOWUPS_AUTONOMOUS=false
# Optional command run with the notice title as its only argument when the scheduler writes an owner
# notice. Unset: notices go only to SQLite and .jobber/notify.jsonl. It may embed a webhook token,
# so it is write-only. Secret.
JOBBER_NOTIFY_CMD=

# =====================================================================================
# Classifier (prompt-injection screen for LinkedIn and Naukri text)
# =====================================================================================

# Active classifier profile id (config/classifier-models.json). Required for live LinkedIn and
# Naukri reads and sends: unset, unpinned, unfitted or erroring means live calls fail closed, dry
# runs continue unscreened. There is no implicit default and no fallback chain. Fetch, pin and fit
# the model first (docs/classifier-models.md), then restart every MCP server and session. Allowed:
# protectai-deberta-v3-base-v2, llama-prompt-guard-2-22m.
CLASSIFIER_MODEL=
# Skip the input classifier in scheduler runs. Honoured for dry runs only; a live run still needs a
# ready classifier. Default false. Allowed: true or false.
SCHEDULER_NO_CLASSIFIER=false
# Doctor only. 1 skips the classifier smoke inference (a warning shows instead). Useful on a machine
# without the model weights. Allowed: 1.
# DOCTOR_SKIP_SMOKE=1

# =====================================================================================
# Limits (daily, weekly, per company, pacing, cooldowns)
# The full catalog with ranges is src/setup/limitsCatalog.ts; `npm run setup -- --step limits`
# edits it. Invalid values fall back to the default. Commented lines show the code default.
# =====================================================================================

# Jobs scoring below this match score are skipped and never contacted. Unit: score. Default 60.
# Integer 0..100.
MATCH_THRESHOLD=60
# Real cold emails sent per day (a daily counter shared by every run that day). Unit: per day.
# Default 1. Integer 0..100.
SEND_LIMIT_PER_RUN=1
# Applications submitted per day across LinkedIn Easy Apply, external ATS and Naukri. Unit: per day.
# Default 5. Integer 0..100000.
MAX_APPLIES_PER_DAY=5
# LinkedIn people-search lookups per day from the main account. Unit: per day. Default 20. Integer
# 0..100000.
MAX_LINKEDIN_SEARCHES_PER_DAY=20
# LinkedIn connection invitations sent per week. Unit: per week. Default 100. Integer 0..100000.
# LINKEDIN_MAX_INVITES_PER_WEEK=100
# LinkedIn direct messages sent per week. Unit: per week. Default 100. Integer 0..100000.
# LINKEDIN_MAX_MESSAGES_PER_WEEK=100
# Naukri applications per day. Unit: per day. Default 30. Integer 0..100000.
# NAUKRI_MAX_APPLIES_PER_DAY=30
# Naukri recruiter messages per day. Unit: per day. Default 40. Integer 0..100000.
# NAUKRI_MAX_MESSAGES_PER_DAY=40
# LinkedIn job and post discovery searches per day from the main account. Unit: per day. Default 12.
# Integer 0..100000.
# LINKEDIN_MAX_DISCOVER_PER_DAY=12
# Most people contacted at one company, so a team is not flooded. Unit: people. Default 5. Integer
# 0..100000.
# COMPANY_CONTACT_LIMIT=5
# Most people contacted at one company when there is no open posting (speculative outreach). Unit:
# people. Default 2. Integer 0..100000.
# SPECULATIVE_COMPANY_LIMIT=2
# Hour (local time) when quiet hours begin and no outreach is sent. Unit: hour 0-23. Default 1.
# Integer 0..23.
# QUIET_HOURS_START=1
# Hour (local time) when quiet hours end and outreach may resume. Unit: hour 0-23. Default 7.
# Integer 0..23.
# QUIET_HOURS_END=7
# Fewest actions in one burst before a longer wait. Unit: actions. Default 1. Integer 1..50.
# PACING_MIN_BURST=1
# Most actions in one burst before a longer wait. Unit: actions. Default 4. Integer 1..50.
# PACING_MAX_BURST=4
# Shortest pause between two actions in a burst. Unit: seconds. Default 120. Integer 1..86400.
# PACING_MIN_ACTION_GAP_SEC=120
# Longest pause between two actions in a burst. Unit: seconds. Default 360. Integer 1..86400.
# PACING_MAX_ACTION_GAP_SEC=360
# Shortest wait between bursts. Unit: minutes. Default 8. Integer 1..1440.
# PACING_MIN_WAIT_MIN=8
# Longest wait between bursts. Unit: minutes. Default 40. Integer 1..1440.
# PACING_MAX_WAIT_MIN=40
# Random variation added to every pause so timing is not regular. Unit: percent. Default 25. Integer
# 0..90.
# PACING_JITTER_PCT=25
# Days before contacting someone again after a sequence they ignored. Unit: days. Default 75.
# Integer 1..3650.
# COOLDOWN_IGNORED_DAYS=75
# Days before contacting someone again after they said not now. Unit: days. Default 75. Integer
# 1..3650.
# COOLDOWN_NOT_NOW_DAYS=75
# Days before contacting someone again after they asked you to stop. Unit: days. Default 120.
# Integer 1..3650.
# COOLDOWN_EXPLICIT_STOP_DAYS=120
# Comma list of days between touches in a sequence, one number per follow-up gap (5 values, each 1
# to 365). Unit: days. Default 3,4,5,7,10.
# CADENCE_GAPS_DAYS=3,4,5,7,10
# Comma list of quiet days before each autonomous email follow-up (4 values: three follow-ups, then
# the feedback message). Used only when FOLLOWUPS_AUTONOMOUS=true; independent of CADENCE_GAPS_DAYS.
# Unit: days. Default 3,4,5,7.
# EMAIL_FOLLOWUP_GAPS_DAYS=3,4,5,7
# Longest age of the last clean reply check that still lets an autonomous email follow-up be claimed
# for sending. Unit: minutes. Used only when FOLLOWUPS_AUTONOMOUS=true. Default 30. Integer 5..240.
FOLLOWUP_CHECK_MAX_AGE_MIN=30

# =====================================================================================
# LinkedIn
# =====================================================================================

# Accept invitations from senders that are not in the people table. Default false. Allowed: true or
# false.
LINKEDIN_ACCEPT_UNKNOWN=false
# Daily cap on accepted invitations. Default 30. Integer 0..1000.
LINKEDIN_MAX_ACCEPTS_PER_DAY=30
# Comma-separated URLs that outbound LinkedIn text may contain. Unset: none allowed.
LINKEDIN_ALLOWED_URLS=
# Comma-separated email addresses that outbound LinkedIn text may contain. Unset: none allowed.
LINKEDIN_ALLOWED_EMAILS=
# Close the LinkedIn browser after this idle time, in milliseconds. Default 600000. Integer
# 60000..3600000.
LINKEDIN_IDLE_MS=600000
# Turn on linkedin_screenshot and linkedin_click_at (a pointer click needs a snapshot and a
# screenshot at the current epoch). Screenshot pixels are NOT checked by the injection classifier,
# so leave it off unless the page tree is not enough. Default false. Allowed: true or false.
LINKEDIN_SCREENSHOT=false
# Days a saved LinkedIn session file may age before it counts as expired. Default 45. Integer
# 1..3650.
# LINKEDIN_SESSION_MAX_AGE_DAYS=45

# =====================================================================================
# Browser apply
# =====================================================================================

# Agent-driven account creation on apply sites (ATS hosts). Flip it per supervised check. Sign-up
# also needs every web dry-run flag false and room under SITE_MAX_ACCOUNTS_PER_DAY. Marketing boxes
# are always left unchecked. Default false. Allowed: true or false.
APPLY_ALLOW_ACCOUNT_CREATION=false
# Apply to a host that is not a known ATS (drives it with the browser agent). When false, a job on
# an unknown host is never applied to. Default false. Allowed: true or false.
APPLY_ALLOW_UNKNOWN_HOSTS=false
# LinkedIn Easy Apply through the burner account. Default false. Allowed: true or false.
APPLY_LINKEDIN_EASY=false
# What apply_submit does at the review step. hold stops there and reports held; submit really clicks
# submit. Anything other than exactly submit holds. A real submit also needs every web dry-run flag
# false. Default hold. Allowed: hold, submit.
APPLY_SUBMIT_MODE=hold
# Offer a screenshot tool to the applier. Screenshot pixels are NOT checked by the injection
# classifier, so leave it off unless you are debugging. Default false. Allowed: true or false.
APPLY_SCREENSHOT=false
# Browser-applier recipes learn from confirmed submitted applications only. A learned recipe for a
# platform with no recipe is written after this many confirmed applications. Default 3. Integer
# 1..50.
APPLY_RECIPE_PROMOTE_N=3
# Confirmed applications for a learned recipe must be spread over at least this many distinct run
# ids. Default 2. Integer 1..20.
APPLY_RECIPE_PROMOTE_RUNS=2
# Allow the scout to create accounts on discovery (job) sites. Needs every web dry-run flag false.
# Default false. Allowed: true or false.
SCOUT_ALLOW_SIGNUP=false
# How a sign-up verification link reaches the browser. owner_assist: you paste the link or mail
# text. gmail: reads one message through the gmail read tools, only when SITE_MAIL_SENDERS is also
# non-empty. off: no verification help. Default owner_assist. Allowed: owner_assist, gmail, off.
SITE_MAIL_VERIFY=owner_assist
# Comma-separated sender addresses (or @domain) whose verification mail may be read in gmail mode.
# Unset: none.
SITE_MAIL_SENDERS=
# Check a required privacy-notice or terms box that a site needs to submit. false: such forms wait
# for you. Attestations and data-sharing boxes always wait for you. Default true. Allowed: true or
# false.
APPLY_ACCEPT_LEGAL_REQUIRED=true
# Optional override of the site accounts file, for tests and recovery. Default
# secrets/site-accounts.json.
# SITE_ACCOUNTS_FILE=
# Turn on scout_screenshot and scout_click_at (a pointer click needs a scout_state and a screenshot
# since the last navigation or scroll). Screenshot pixels are NOT checked by the injection
# classifier, so leave it off unless the page tree is not enough. Default false. Allowed: true or
# false.
SCOUT_SCREENSHOT=false
# Browser application attempts per day across all company sites and ATS hosts (submitted or not).
# Unit: per day. Default 30. Integer 0..100000.
# APPLY_MAX_ATTEMPTS_PER_DAY=30
# New accounts created on company sites and ATS hosts per day. Unit: per day. Default 2. Integer
# 0..100000.
# SITE_MAX_ACCOUNTS_PER_DAY=2
# Applications per day to one company or ATS host, used for every platform without its own
# APPLY_MAX_PER_HOST_<ID> value. Unit: per host per day. Default 10. Integer 1..50.
APPLY_MAX_PER_HOST=10
# Applications per day to one greenhouse host. Unset or invalid falls back to APPLY_MAX_PER_HOST,
# then 10. Unit: per host per day. Default 10. Integer 1..50.
# APPLY_MAX_PER_HOST_GREENHOUSE=10
# Applications per day to one lever host. Unset or invalid falls back to APPLY_MAX_PER_HOST, then
# 10. Unit: per host per day. Default 10. Integer 1..50.
# APPLY_MAX_PER_HOST_LEVER=10
# Applications per day to one ashby host. Unset or invalid falls back to APPLY_MAX_PER_HOST, then
# 10. Unit: per host per day. Default 10. Integer 1..50.
# APPLY_MAX_PER_HOST_ASHBY=10
# Applications per day to one workable host. Unset or invalid falls back to APPLY_MAX_PER_HOST, then
# 10. Unit: per host per day. Default 10. Integer 1..50.
# APPLY_MAX_PER_HOST_WORKABLE=10
# Applications per day to one smartrecruiters host. Unset or invalid falls back to
# APPLY_MAX_PER_HOST, then 10. Unit: per host per day. Default 10. Integer 1..50.
# APPLY_MAX_PER_HOST_SMARTRECRUITERS=10
# Applications per day to one workday host. Unset or invalid falls back to APPLY_MAX_PER_HOST, then
# 10. Unit: per host per day. Default 10. Integer 1..50.
# APPLY_MAX_PER_HOST_WORKDAY=10
# Applications per day to one recruitee host. Unset or invalid falls back to APPLY_MAX_PER_HOST,
# then 10. Unit: per host per day. Default 10. Integer 1..50.
# APPLY_MAX_PER_HOST_RECRUITEE=10
# Applications per day to one personio host. Unset or invalid falls back to APPLY_MAX_PER_HOST, then
# 10. Unit: per host per day. Default 10. Integer 1..50.
# APPLY_MAX_PER_HOST_PERSONIO=10
# Applications per day to one browser host. Unset or invalid falls back to APPLY_MAX_PER_HOST, then
# 10. Unit: per host per day. Default 10. Integer 1..50.
# APPLY_MAX_PER_HOST_BROWSER=10
# Next, back and save clicks one browser application may make before the applier stops. Unit: steps.
# Default 12. Integer 1..50.
APPLY_MAX_STEPS=12
# Days the browser applier leaves a host alone after two blocks (captcha, MFA, phone check, bot
# wall) within 7 days. Unit: days. Default 7. Integer 1..90.
APPLY_HOST_COOLDOWN_DAYS=7

# =====================================================================================
# Web core (shared browser for company sites)
# =====================================================================================

# Seconds between two page loads on the same host, plus code-drawn jitter. Default 20. Integer
# 0..3600.
# WEB_MIN_GAP_SEC=20
# Page loads allowed per job. Default 80. Integer 1..1000.
# WEB_MAX_CALLS_PER_JOB=80
# Minutes one job may keep the browser. Default 15. Integer 1..240.
# WEB_MAX_JOB_MIN=15
# Close the web browser after this idle time, in milliseconds. Default 600000. Integer
# 60000..3600000.
# WEB_IDLE_MS=600000
# Wait after each page load, in milliseconds. Default 1500. Integer 0..30000.
# WEB_SETTLE_MS=1500

# =====================================================================================
# Generated job sources and search
# =====================================================================================

# Jobs a captured page must reproduce before a proposed (agent-written) job-source provider counts
# as validated. Default 3. Integer 1..50.
# GEN_PROVIDER_MIN_JOBS=3
# Clean runs (over at least two distinct run ids) before a validated provider becomes trusted and is
# listed for your review. Its outreach stays held until you approve it with npm run providers --
# approve <id>. Default 3. Integer 1..20.
# GEN_PROVIDER_PROMOTE_N=3

# =====================================================================================
# Naukri
# =====================================================================================

# Run Naukri search with the headless recipe (patchright plus installed Google Chrome, real user
# agent). Unset: the old headed browser. Only the exact value true is read. Akamai blocks stock
# headless Chromium; re-check from a VPS IP before relying on it. Allowed: true.
# NAUKRI_HEADLESS=true
# Turn on naukri_screenshot and naukri_click_at (a pointer click needs a snapshot and a screenshot
# at the current epoch). Screenshot pixels are NOT checked by the injection classifier, so leave it
# off unless the page tree is not enough. Default false. Allowed: true or false.
NAUKRI_SCREENSHOT=false

# =====================================================================================
# Scheduler
# =====================================================================================

# Whether the scheduler daemon runs. false makes the daemon exit at start. Default true. Allowed:
# true or false.
SCHEDULER_ENABLED=true
# tmux session that holds the wake windows. Letters, digits, underscore and hyphen. Default
# jobber-runs.
SCHEDULER_TMUX_SESSION=jobber-runs
# Tool call budget per wake. Default 60. Integer 1..1000.
RUN_MAX_TOOL_CALLS=60
# Wall clock budget per wake, in seconds. Default 900. Integer 30..7200.
RUN_MAX_WALL_SEC=900
# Approximate token budget per wake (stream characters divided by 4). Max turns is owned by the run
# profile and has no env override. Default 150000. Integer 1000..2000000.
RUN_MAX_TOKENS_APPROX=150000
# Minutes between recruiter inbox sweeps. Default 60. Integer 1..10000.
INBOX_EVERY_MIN=60
# Hours between Naukri discover runs. Default 6. Integer 1..10000.
NAUKRI_DISCOVER_EVERY_HOURS=6
# Minutes to pause after the subscription usage limit is hit. Default 300. Integer 1..10080.
USAGE_LIMIT_BACKOFF_MIN=300
# Let the scheduler run the auto-update tick (needs scripts/auto-update.ts). Updates are
# fast-forward only, signed by default, test-gated and rolled back on failure. Allowed: true or
# false.
AUTO_UPDATE=false
# Let the scheduler run the backup tick (needs scripts/backup.ts). Needs BACKUP_DIR and
# BACKUP_AGE_RECIPIENT. Default false. Allowed: true or false.
BACKUP_ENABLED=false
# Seconds the scheduler waits for an update or backup tick to finish. Default 120. Integer 30..3600.
# SCHEDULER_HOOK_TIMEOUT_SEC=120
# Minimum minutes between two update or backup ticks. Default 60. Integer 1..1440.
# HOOK_MIN_INTERVAL_MIN=60

# =====================================================================================
# Dashboard (npm run web)
# =====================================================================================

# Local dashboard port. Default 8787. Integer 1024..65535.
WEB_PORT=8787
# tmux session the dashboard chat box targets. Used only when WEB_CHAT_ENABLED=true. Default ccgram.
WEB_TMUX_SESSION=ccgram
# tmux window the dashboard chat box targets. Used only when WEB_CHAT_ENABLED=true. Default
# JobApplier.
WEB_TMUX_WINDOW=JobApplier
# Dashboard sign-in mode. Left unset on an existing OIDC install it keeps working (see
# docs/dashboard-exposure.md). Default token. Allowed: token, google_desktop, oidc.
WEB_AUTH_MODE=token
# google_desktop only: keys file of the Gmail Desktop OAuth client. Blank uses GMAIL_OAUTH_PATH.
WEB_GOOGLE_KEYS_PATH=
# google_desktop only: callback address shape. callback is /auth/callback, root is /. Try root if
# Google refuses callback. Default callback. Allowed: callback, root.
WEB_GOOGLE_REDIRECT_SHAPE=callback
# The one Google account allowed to sign in (google_desktop and oidc). npm run setup fills it.
DASHBOARD_ALLOWED_EMAIL=
# oidc only: issuer address (https). Default https://accounts.google.com.
WEB_OIDC_ISSUER=https://accounts.google.com
# oidc only: Google OAuth Web client id. Required when WEB_AUTH_MODE=oidc.
WEB_OIDC_CLIENT_ID=
# oidc only: Google OAuth Web client secret. Required when WEB_AUTH_MODE=oidc. Secret.
WEB_OIDC_CLIENT_SECRET=
# oidc only: sign-in callback address. Default http://127.0.0.1:8787/auth/callback.
WEB_OIDC_REDIRECT_URI=http://127.0.0.1:8787/auth/callback
# oidc only: how Google asks for re-authentication. Default select_account.
WEB_OIDC_REAUTH_PROMPT=select_account
# Seconds a sign-in stays fresh before re-authentication is required for sensitive changes. Default
# 300. Integer 60..3600.
WEB_REAUTH_MAX_AGE_SEC=300
# Path of the dashboard sign-in database. Default .dashboard/auth.sqlite.
WEB_AUTH_DB=.dashboard/auth.sqlite
# Listen address. Loopback only unless WEB_ALLOW_REMOTE_BIND=true. Default 127.0.0.1.
WEB_BIND=127.0.0.1
# Allow a non-loopback listen address on purpose. Default false. Allowed: true or false.
WEB_ALLOW_REMOTE_BIND=false
# Comma list of extra Host values (tunnel hostnames), hostname or host:port. Unset: none.
WEB_ALLOWED_HOSTS=
# Trust forwarded headers from a reverse proxy. Set true only behind a trusted proxy. Default false.
# Allowed: true or false.
WEB_TRUST_PROXY=false
# Enable the two-step dashboard chat send into the tmux window. Use a read_only permission set if
# you enable it. Default false. Allowed: true or false.
WEB_CHAT_ENABLED=false
# Master switch of the dashboard settings editor. While false the Settings page is read-only and
# every write route is refused. Turn it on by hand in .env and restart the dashboard. Default false.
# Allowed: true or false.
# WEB_SETTINGS_EDIT=false
# Allow safety-tier weakening changes (going live and similar) while the dashboard is bound off
# loopback or behind a proxy. Ships false, so a stolen token over the network cannot go live.
# Default false. Allowed: true or false.
# WEB_SETTINGS_REMOTE_SAFETY=false

# =====================================================================================
# Telegram (ccgram bridge)
# =====================================================================================

# Bot token from @BotFather. Required for the Telegram bridge. Unset: the bridge does not start (the
# setup step can be skipped by choice). Secret.
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user ids allowed to talk to the bot. Required together with the
# bot token.
ALLOWED_USERS=
# tmux session of the ccgram daemon. Letters, digits, underscore and hyphen. Default ccgram-daemon.
# CCGRAM_DAEMON_SESSION=ccgram-daemon
# tmux session of the manager windows. Blank uses the session in config/manager-windows.json.
# MANAGER_TMUX_SESSION=ccgram

# =====================================================================================
# Layout memory (plan 8B)
# All optional. The values shown are the defaults. Invalid values fall back to the default.
# =====================================================================================

# off, warn or enforce. enforce refuses the irreversible typed LinkedIn sends on drift or unknown
# layouts; learn first (CLAUDE.md, Layout memory). Any change is treated as weakening because
# leaving enforce loosens the guard. Default warn. Allowed: off, warn, enforce.
# LAYOUT_ENFORCE=warn
# Observations before a layout variant is promoted. Invalid values fall back to the default. Integer
# 1..1000.
# LAYOUT_PROMOTE_N=3
# Distinct run ids needed for promotion. Invalid values fall back to the default. Integer 1..1000.
# LAYOUT_PROMOTE_RUNS=2
# Days before a learned kind counts as stale. Invalid values fall back to the default. Integer
# 1..3650.
# LAYOUT_STALE_DAYS=30
# Drift streak that writes an owner escalation. Invalid values fall back to the default. Integer
# 1..1000.
# LAYOUT_DRIFT_ESCALATE_N=3
# Drift streak that halts the platform (it also needs 2 run ids and may not be below the escalate
# value). Invalid values fall back to the default. Integer 1..1000.
# LAYOUT_DRIFT_HALT_N=5
# Window for the drift streak, in hours. Invalid values fall back to the default. Integer 1..8760.
# LAYOUT_DRIFT_WINDOW_HOURS=24
# Layout file size cap, in bytes. Invalid values fall back to the default. Integer 4096..1048576.
# LAYOUT_MAX_BYTES=65536
# Cap on the memory text shown to an operator. Invalid values fall back to the default. Integer
# 100..20000.
# LAYOUT_RENDER_MAX_CHARS=1200
# Page text shorter than this counts as unloaded. Invalid values fall back to the default. Integer
# 1..2000.
# LAYOUT_UNLOADED_MAX_CHARS=80
# Parsed but prompt-only: the operators prompts state 6 and it is not enforced. Invalid values fall
# back to the default. Integer 0..100.
# LAYOUT_EXPLORE_BUDGET=6
# Landmark score for a layout match, a decimal from 0 to 1. Invalid values fall back to the default.
# LAYOUT_MATCH_MIN=0.9
# Landmark score for a partial layout match, a decimal from 0 to 1, not above the match value.
# Invalid pairs fall back to the defaults. Default 0.6.
# LAYOUT_PARTIAL_MIN=0.6
# Layout store directory. Must resolve inside the project, otherwise the default is used.
# LAYOUT_DIR=.jobber/layout

# =====================================================================================
# Update and backup (plan 7D). See docs/backup-and-restore.md.
# =====================================================================================

# Git remote the update fetches from. Use the upstream remote, not a fork you cannot trust. Default
# origin.
AUTO_UPDATE_REMOTE=origin
# Branch the update fast-forwards to. Default main.
AUTO_UPDATE_BRANCH=main
# Optional tag glob (for example v*). Empty follows the branch tip.
AUTO_UPDATE_TAG_PATTERN=
# Require signed commits. Exactly false turns the signature check off (the doctor warns). Default
# true. Allowed: true or false.
AUTO_UPDATE_REQUIRE_SIGNED=true
# allowed_signers file with the maintainer SSH public keys. Required while signatures are required.
AUTO_UPDATE_SIGNERS_FILE=
# Comma list of paths that force a manual review. Empty keeps the built-in list.
AUTO_UPDATE_REVIEW_PATHS=
# Backup destination outside the project, ideally another disk (mode 700). Required for backups.
BACKUP_DIR=
# The age PUBLIC key (starts with age1) backups are encrypted to. Never a private key. Required for
# backups.
BACKUP_AGE_RECIPIENT=
# Also archive secrets/ (OAuth tokens, browser sessions). See the runbook before enabling. Default
# false. Allowed: true or false.
BACKUP_INCLUDE_SECRETS=false
# Optional rclone mirror, for example gdrive:jobber-backups (name:path). Empty: no mirror.
BACKUP_RCLONE_REMOTE=
# Daily archives kept. Default 7. Integer 0..365.
BACKUP_RETAIN_DAILY=7
# Weekly archives kept. Default 4. Integer 0..365.
BACKUP_RETAIN_WEEKLY=4
# Monthly archives kept. Default 6. Integer 0..365.
BACKUP_RETAIN_MONTHLY=6

# =====================================================================================
# Advanced
# =====================================================================================

# Model routing for the claude CLI (docs/model-auth-setup.md): heaviest-tier model name. Claude Code
# itself reads it; Jobber code does not. Remove the value to use the default.
ANTHROPIC_DEFAULT_OPUS_MODEL=deepseek/deepseek-v4-pro
# Third-party endpoint, only with env-based auth. Do not run /login if you use it. It can carry
# credentials, so it is write-only. Secret.
# ANTHROPIC_BASE_URL=
# API key sent to the third-party endpoint. Secret.
# ANTHROPIC_AUTH_TOKEN=
# Main working model name for the third-party endpoint.
# ANTHROPIC_DEFAULT_SONNET_MODEL=
# Small and fast subtask model name for the third-party endpoint.
# ANTHROPIC_DEFAULT_HAIKU_MODEL=
# Path of the claude CLI used by the hybrid fallbacks. Blank means claude from PATH. Default claude.
# CLAUDE_CLI_PATH=claude
# Model alias for npm run eval:gen and eval:judge. A --model flag wins. Default sonnet.
# EVAL_MODEL=sonnet
# Folder holding the personal data files (resume.json and others). Relative paths resolve from the
# project root. Mode 700 is expected. Default user-data.
# JOBAPPLIER_USER_DATA=user-data
# tmux session holding the scheduler and web windows started by npm run up. Default jobber-stack.
# STACK_TMUX_SESSION=jobber-stack
# Seconds npm run down waits for the scheduler to finish its wake. Values outside the range are
# clamped. Default 60. Integer 5..600.
# STACK_DOWN_WAIT_SEC=60
# Classifier model profile the bootstrap downloads. Empty means the default profile.
# BOOTSTRAP_MODEL_PROFILE=
# Backups kept per target (the env file and each edited config file) by the settings editor. Older
# ones are removed after a save. Default 10. Integer 1..100.
# SETTINGS_BACKUP_KEEP=10
