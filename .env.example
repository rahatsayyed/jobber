# Jobber environment file.
#
# Copy this file to `.env` (mode 600, gitignored) and fill in the values, or run `npm run setup`,
# which writes the values for you. `.env.example` itself is committed and holds no secrets.
#
# Format rules (every loader in this project reads the file the same way):
# - One `KEY=value` per line. Surrounding single or double quotes are stripped, nothing else.
# - NEVER put a comment after a value on the same line: the loaders read the inline comment as
#   part of the value, so `MATCH_THRESHOLD=60  # note` makes the limit invalid. Comments go on
#   their own line above the key.
# - A blank value (`KEY=`) means "not set". A commented-out line (`# KEY=value`) is an optional
#   setting that stays unset by default; the value shown is the code default.
# - Nothing here is sourced into a shell. Launchers parse the file and pass an allowlisted
#   environment to child processes.
# - Defaults, ranges and meanings of the numeric limits also live in src/setup/limitsCatalog.ts.

# =====================================================================================
# Credentials: job sources
# =====================================================================================

# Adzuna developer app id (developer.adzuna.com). Optional, enables the Adzuna job source
# (country in). Unset: Adzuna is skipped.
ADZUNA_APP_ID=
# Adzuna developer key. Secret. Optional, pairs with ADZUNA_APP_ID. Unset: Adzuna is skipped.
ADZUNA_APP_KEY=

# =====================================================================================
# Credentials: contact finding (company domain and email lookup)
# =====================================================================================

# Serper search key (serper.dev). Secret. Optional, used for contact finding only, and only after
# the search cache and browser dorking miss, under the budgets below. Unset: Serper is never called.
SERPER_API_KEY=
# Hunter.io key (hunter.io). Secret. Optional, the LAST resort email source.
# Unset or HUNTER_ENABLED not true: Hunter is never called.
HUNTER_API_KEY=
# Whether Hunter lookups are allowed. Default false. Allowed: true or false. Keep false for the
# first smoke test.
HUNTER_ENABLED=false
# Hard cap on Hunter credits per month. Default 50, integer 0..100000. Required only when
# HUNTER_ENABLED=true.
HUNTER_MONTHLY_CAP=50
# Whether contact finding may search through the browser first (a dork). Default true. Allowed:
# true or false. false: the cache, then Serper under budget.
DORK_ENABLED=true
# Hours the browser dork stays off after a search engine blocks it. Default 24, integer 0..720.
DORK_BLOCK_COOLDOWN_HOURS=24
# Days a search result is reused before it is searched again. Default 14, integer 0..365.
SEARCH_CACHE_TTL_DAYS=14
# Serper searches allowed per day. Default 20, integer 0..100000.
SERPER_DAILY_BUDGET=20
# Serper searches allowed per calendar month. Default 200, integer 0..1000000.
SERPER_MONTHLY_BUDGET=200
# Browser dork searches allowed per day. Default 30, integer 0..100000.
DORK_DAILY_BUDGET=30
# Generated job-source providers (declarative specs the agent proposes, validated in code).
# Jobs a captured page must reproduce before a proposed provider counts as validated. Default 3, integer 1..50.
# GEN_PROVIDER_MIN_JOBS=3
# Clean runs (over at least two distinct run ids) before a validated provider becomes trusted and
# is listed for your review. Default 3, integer 1..20. Its outreach stays held until you approve it
# with: npm run providers -- approve <id>
# GEN_PROVIDER_PROMOTE_N=3

# =====================================================================================
# Credentials: Gmail (cold email send and reply reading)
# =====================================================================================

# Google OAuth client keys file. Needed for email outreach and reply checks. Default
# ./secrets/gcp-oauth.keys.json (gitignored). Put the client JSON there. Token is written to
# GMAIL_CREDENTIALS_PATH after: set -a; source .env; set +a; npx -y @gongrzhe/server-gmail-autoauth-mcp auth
GMAIL_OAUTH_PATH=./secrets/gcp-oauth.keys.json
# Where the Gmail login token is stored. Default ./secrets/gmail-credentials.json.
GMAIL_CREDENTIALS_PATH=./secrets/gmail-credentials.json
# Legacy SMTP address. Unused with the OAuth server above. Optional, leave blank.
GMAIL_USER=
# Legacy SMTP app password. Secret. Unused with the OAuth server above. Optional, leave blank.
GMAIL_APP_PASSWORD=

# =====================================================================================
# Safety and dry-run flags
# Any dry flag wins, and an unset flag counts as dry. Only the owner flips these.
# =====================================================================================

# Hunt-side dry run. Ships 1 (dry). Allowed: 1 (dry, and the Gmail send hook denies
# gmail.send_email) or anything else, such as 0 (this flag no longer forces dry).
# Live also needs SCHEDULER_DRY_RUN=false and, for LinkedIn paths, LINKEDIN_DRY_RUN=false.
JOBBER_DRY_RUN=1
# Scheduler dry run. Ships true (dry). Dry unless the value is exactly false.
# Allowed: true or false. Live also needs LINKEDIN_DRY_RUN=false for LinkedIn paths.
SCHEDULER_DRY_RUN=true
# LinkedIn typed tools dry run. Ships true (dry). Dry unless the value is exactly false.
# Allowed: true or false.
LINKEDIN_DRY_RUN=true
# Web dry run (company sites and ATS pages: login, sign-up, upload, typing, next/submit).
# Ships true (dry). Dry unless the value is exactly false. Live needs WEB_DRY_RUN, APPLY_DRY_RUN
# and SCOUT_DRY_RUN all false, plus SCHEDULER_DRY_RUN=false.
WEB_DRY_RUN=true
# Browser applier dry run. Ships true (dry). Dry unless the value is exactly false.
APPLY_DRY_RUN=true
# Source scout dry run. Ships true (dry). Dry unless the value is exactly false.
SCOUT_DRY_RUN=true
# Kill switch. Default 0. Allowed: 1 stops every wake (same effect as the .jobber/STOP file),
# anything else is off. Prefer: npm run jobber:control -- stop
JOBBER_KILL=0
# Autonomous email follow-ups. Ships false (legacy: 10+ days quiet, max 2 per job, each approved
# on Telegram). Allowed: exactly true or false. Set true only after reading the cadence: up to 3
# follow-ups then a feedback message, sent with no per-draft approval, at EMAIL_FOLLOWUP_GAPS_DAYS
# quiet days, only on a clean reply check no older than FOLLOWUP_CHECK_MAX_AGE_MIN, under the
# shared SEND_LIMIT_PER_RUN.
FOLLOWUPS_AUTONOMOUS=false
# Optional command run with the notice title as its only argument when the scheduler writes an
# owner notice. Default unset: notices go only to SQLite and .jobber/notify.jsonl.
JOBBER_NOTIFY_CMD=

# =====================================================================================
# Classifier (prompt-injection screen for LinkedIn and Naukri text)
# =====================================================================================

# Active classifier profile id. REQUIRED for live LinkedIn and Naukri reads and sends: unset,
# unpinned, unfitted or erroring means live calls fail closed (classifier_unavailable). Dry runs
# still work, marked unscreened. There is no implicit default and no fallback chain.
# Default profile id in config/classifier-models.json: protectai-deberta-v3-base-v2
# (the other known id is llama-prompt-guard-2-22m, owner-supplied files).
# Command order, once per profile (see docs/classifier-models.md):
#   1. npm run models -- fetch protectai-deberta-v3-base-v2
#   2. npm run models -- pin protectai-deberta-v3-base-v2
#   3. npm run classifier:fit -- --profile protectai-deberta-v3-base-v2 --write
#   4. set CLASSIFIER_MODEL=protectai-deberta-v3-base-v2 here, then npm run doctor
# Or run: npm run setup -- --step classifier (does the fetch and the write, never the pin).
# Restart every MCP server and session after changing it.
CLASSIFIER_MODEL=
# Skip the input classifier in scheduler runs. Default false. Allowed: true or false.
# Honoured for dry runs only; a live run still needs a ready classifier.
SCHEDULER_NO_CLASSIFIER=false
# Doctor only. Default unset. Allowed: 1 skips the classifier smoke inference (a warn shows
# instead). Useful on a machine without the model weights.
# DOCTOR_SKIP_SMOKE=1

# =====================================================================================
# Limits (daily, weekly, per company, pacing, cooldowns)
# The full catalog with ranges is src/setup/limitsCatalog.ts; `npm run setup -- --step limits`
# edits it. Invalid values fall back to the default. Commented lines show the code default.
# =====================================================================================

# Minimum match score for a job to be pursued. Default 60, integer 0..100. Lower sends outreach
# for weaker matches.
MATCH_THRESHOLD=60
# Real cold emails per day (a daily counter shared by every run that day, follow-ups included).
# Default 1, integer 0..100. Raise once trusted.
SEND_LIMIT_PER_RUN=1
# Applications submitted per day across LinkedIn Easy Apply, external ATS and Naukri.
# Default 5, integer 0..100000.
MAX_APPLIES_PER_DAY=5
# LinkedIn people-search lookups per day (main account). Default 20, integer 0..100000.
MAX_LINKEDIN_SEARCHES_PER_DAY=20
# Newest clean reply check may be at most this many minutes old before an autonomous follow-up
# is claimed. Default 30, integer 5..240. Used only when FOLLOWUPS_AUTONOMOUS=true.
FOLLOWUP_CHECK_MAX_AGE_MIN=30
# LinkedIn connection invitations per week. Default 100, integer 0..100000.
# LINKEDIN_MAX_INVITES_PER_WEEK=100
# LinkedIn direct messages per week. Default 100, integer 0..100000.
# LINKEDIN_MAX_MESSAGES_PER_WEEK=100
# Naukri applications per day. Default 30, integer 0..100000.
# NAUKRI_MAX_APPLIES_PER_DAY=30
# Naukri recruiter messages per day. Default 40, integer 0..100000.
# NAUKRI_MAX_MESSAGES_PER_DAY=40
# Browser application attempts per day across all hosts. Default 30, integer 0..100000.
# Keep it above the per-host cap.
# APPLY_MAX_ATTEMPTS_PER_DAY=30
# New accounts created on company sites and ATS hosts per day. Default 2, integer 0..100000.
# SITE_MAX_ACCOUNTS_PER_DAY=2
# LinkedIn job and post discovery searches per day (main account). Default 12, integer 0..100000.
# LINKEDIN_MAX_DISCOVER_PER_DAY=12
# Applications per day to one host. Default 10, integer 1..50 (outside the range is clamped
# and npm run doctor warns; empty or not a number counts as unset).
APPLY_MAX_PER_HOST=10
# Per-platform override of APPLY_MAX_PER_HOST, same range. Unset or invalid falls back to
# APPLY_MAX_PER_HOST, then 10. One line per platform id.
# APPLY_MAX_PER_HOST_GREENHOUSE=10
# APPLY_MAX_PER_HOST_LEVER=10
# APPLY_MAX_PER_HOST_ASHBY=10
# APPLY_MAX_PER_HOST_WORKABLE=10
# APPLY_MAX_PER_HOST_SMARTRECRUITERS=10
# APPLY_MAX_PER_HOST_WORKDAY=10
# APPLY_MAX_PER_HOST_RECRUITEE=10
# APPLY_MAX_PER_HOST_PERSONIO=10
# APPLY_MAX_PER_HOST_BROWSER=10
# Most people contacted at one company. Default 5, integer 0..100000.
# COMPANY_CONTACT_LIMIT=5
# Most people contacted at one company with no open posting. Default 2, integer 0..100000.
# SPECULATIVE_COMPANY_LIMIT=2
# Quiet hours start, hour 0..23 (IST). Default 1. No outreach is sent in the window.
# QUIET_HOURS_START=1
# Quiet hours end, hour 0..23 (IST). Default 7.
# QUIET_HOURS_END=7
# Fewest actions in one burst before a longer wait. Default 1, integer 1..50.
# PACING_MIN_BURST=1
# Most actions in one burst before a longer wait. Default 4, integer 1..50.
# PACING_MAX_BURST=4
# Shortest pause between two actions in a burst, seconds. Default 120, integer 1..86400.
# PACING_MIN_ACTION_GAP_SEC=120
# Longest pause between two actions in a burst, seconds. Default 360, integer 1..86400.
# PACING_MAX_ACTION_GAP_SEC=360
# Shortest wait between bursts, minutes. Default 8, integer 1..1440.
# PACING_MIN_WAIT_MIN=8
# Longest wait between bursts, minutes. Default 40, integer 1..1440.
# PACING_MAX_WAIT_MIN=40
# Random variation added to every pause, percent. Default 25, integer 0..90.
# PACING_JITTER_PCT=25
# Days before contacting someone again after a sequence they ignored. Default 75, 1..3650.
# COOLDOWN_IGNORED_DAYS=75
# Days before contacting someone again after they said not now. Default 75, 1..3650.
# COOLDOWN_NOT_NOW_DAYS=75
# Days before contacting someone again after they asked you to stop. Default 120, 1..3650.
# COOLDOWN_EXPLICIT_STOP_DAYS=120
# Comma list of days between touches in a LinkedIn or Naukri sequence, 5 values each 1..365.
# Default 3,4,5,7,10 (GAPS_DAYS in src/outreach/cadence.ts).
# CADENCE_GAPS_DAYS=3,4,5,7,10
# Comma list of quiet days before each autonomous email follow-up: 4 integers 1..365 (three
# follow-ups, then the feedback message). Default 3,4,5,7. Used only when
# FOLLOWUPS_AUTONOMOUS=true. Independent of CADENCE_GAPS_DAYS.
# EMAIL_FOLLOWUP_GAPS_DAYS=3,4,5,7

# =====================================================================================
# LinkedIn
# =====================================================================================

# Accept invitations from senders that are not in the people table. Default false.
# Allowed: true or false.
LINKEDIN_ACCEPT_UNKNOWN=false
# Daily cap on accepted invitations. Default 30, integer 0..1000.
LINKEDIN_MAX_ACCEPTS_PER_DAY=30
# Comma-separated URLs outbound LinkedIn text may contain. Default unset: none allowed.
LINKEDIN_ALLOWED_URLS=
# Comma-separated email addresses outbound LinkedIn text may contain. Default unset: none allowed.
LINKEDIN_ALLOWED_EMAILS=
# Close the LinkedIn browser after this idle time, milliseconds. Default 600000,
# integer 60000..3600000.
LINKEDIN_IDLE_MS=600000
# Shared web browser (company sites, ATS pages). Seconds between two page loads on the same
# host, plus code-drawn jitter. Default 20, integer 0..3600.
# WEB_MIN_GAP_SEC=20
# Page loads allowed per job. Default 80, integer 1..1000.
# WEB_MAX_CALLS_PER_JOB=80
# Minutes one job may keep the browser. Default 15, integer 1..240.
# WEB_MAX_JOB_MIN=15
# Close the web browser after this idle time, milliseconds. Default 600000, integer 60000..3600000.
# WEB_IDLE_MS=600000
# Wait after each page load, milliseconds. Default 1500, integer 0..30000.
# WEB_SETTLE_MS=1500
# Agent-driven account creation on apply sites (ATS hosts). Ships false. Allowed: exactly true or
# false. Flip it per supervised check (Workday last). Sign-up also needs every web dry-run flag
# false and room under SITE_MAX_ACCOUNTS_PER_DAY. Marketing boxes are always left unchecked.
APPLY_ALLOW_ACCOUNT_CREATION=false
# Same, for discovery (job) sites the scout visits. Ships false. Allowed: exactly true or false.
SCOUT_ALLOW_SIGNUP=false
# How a sign-up verification link reaches the browser. Allowed: owner_assist (default: you paste the
# link or mail text), gmail (reads one message through the gmail read tools, only when
# SITE_MAIL_SENDERS is also non-empty), off. Setting senders alone never switches to gmail.
SITE_MAIL_VERIFY=owner_assist
# Comma-separated sender addresses (or @domain) whose verification mail may be read in gmail mode.
# Default empty: none.
SITE_MAIL_SENDERS=
# Check a required privacy-notice or terms box that a site needs to submit. Allowed: true (default)
# or false (such forms then wait for you). Attestations and data-sharing boxes always wait for you.
APPLY_ACCEPT_LEGAL_REQUIRED=true
# Optional override of the site accounts file, for tests and recovery. Default secrets/site-accounts.json.
# SITE_ACCOUNTS_FILE=
# Days a saved LinkedIn session file may age before it counts as expired. Default 45,
# any positive number. Optional.
# LINKEDIN_SESSION_MAX_AGE_DAYS=45
# Safety latch for scripts/linkedin-login.ts (npm run linkedin:login). Allowed: main. Set it
# only for the shell that runs the login; leave unset otherwise. Unset: the login script refuses.
# LINKEDIN_LOGIN_ACCOUNT=main
# Hybrid Claude fallback when an Easy Apply selector misses (shells out to the claude CLI).
# Default off. Allowed: exactly true or false.
# EASY_APPLY_HYBRID_FALLBACK=false
# Same hybrid fallback for external ATS submit buttons (Greenhouse, Lever, Workday, Ashby).
# Default off. Allowed: exactly true or false. Independent of the Easy Apply toggle.
# EXTERNAL_APPLY_HYBRID_FALLBACK=false

# =====================================================================================
# Naukri
# =====================================================================================

# Run Naukri search with the headless recipe (patchright plus installed Google Chrome, real
# user agent). Default unset: the old headed browser. Allowed: exactly true. Akamai blocks stock
# headless Chromium, so only this recipe passes. Re-check from a VPS IP before relying on it.
# NAUKRI_HEADLESS=true

# =====================================================================================
# Scheduler
# =====================================================================================

# Whether the scheduler daemon runs. Default true. Allowed: true or false. false makes the
# daemon exit at start.
SCHEDULER_ENABLED=true
# tmux session that holds the wake windows. Default jobber-runs. Letters, digits, _ and -.
SCHEDULER_TMUX_SESSION=jobber-runs
# Tool call budget per wake. Default 60.
RUN_MAX_TOOL_CALLS=60
# Wall clock budget per wake, seconds. Default 900.
RUN_MAX_WALL_SEC=900
# Approximate token budget per wake (stream characters / 4). Default 150000.
RUN_MAX_TOKENS_APPROX=150000
# Max turns is profile-owned (config/run-profiles.json max_turns); there is no env override.
# Minutes between recruiter inbox sweeps. Default 60.
INBOX_EVERY_MIN=60
# Hours between Naukri discover runs. Default 6.
NAUKRI_DISCOVER_EVERY_HOURS=6
# Minutes to pause after the subscription usage limit. Default 300.
USAGE_LIMIT_BACKOFF_MIN=300
# Let the scheduler run the auto-update tick (needs scripts/auto-update.ts). Default false.
# Allowed: exactly true or false.
AUTO_UPDATE=false
# Let the scheduler run the backup tick (needs scripts/backup.ts). Default false.
# Allowed: exactly true or false.
BACKUP_ENABLED=false
# Seconds the scheduler waits for an update or backup tick to finish. Default 120,
# integer 30..3600. Optional.
# SCHEDULER_HOOK_TIMEOUT_SEC=120
# Minimum minutes between two update or backup ticks. Default 60, integer 1..1440. Optional.
# HOOK_MIN_INTERVAL_MIN=60

# =====================================================================================
# Dashboard (npm run web)
# =====================================================================================

# Local dashboard port. Default 8787.
WEB_PORT=8787
# tmux session the dashboard chat box targets. Default ccgram. Used only when
# WEB_CHAT_ENABLED=true.
WEB_TMUX_SESSION=ccgram
# tmux window the dashboard chat box targets. Default JobApplier. Used only when
# WEB_CHAT_ENABLED=true.
WEB_TMUX_WINDOW=JobApplier
# Dashboard sign-in mode. Default token. Allowed: token, google_desktop or oidc. Left unset on
# an existing OIDC install it keeps working (see docs/dashboard-exposure.md).
WEB_AUTH_MODE=token
# google_desktop only: keys file of the Gmail Desktop OAuth client. Default: GMAIL_OAUTH_PATH.
WEB_GOOGLE_KEYS_PATH=
# google_desktop only: callback address shape. Default callback. Allowed: callback (/auth/callback)
# or root (/). Try root if Google refuses callback.
WEB_GOOGLE_REDIRECT_SHAPE=callback
# The one Google account allowed to sign in (google_desktop and oidc). `npm run setup` fills it.
DASHBOARD_ALLOWED_EMAIL=
# oidc only: issuer address. Default https://accounts.google.com.
WEB_OIDC_ISSUER=https://accounts.google.com
# oidc only: Google OAuth Web client id. Required when WEB_AUTH_MODE=oidc.
WEB_OIDC_CLIENT_ID=
# oidc only: Google OAuth Web client secret. Secret. Required when WEB_AUTH_MODE=oidc.
WEB_OIDC_CLIENT_SECRET=
# oidc only: sign-in callback address. Default http://127.0.0.1:8787/auth/callback.
WEB_OIDC_REDIRECT_URI=http://127.0.0.1:8787/auth/callback
# oidc only: how Google asks for re-authentication. Default select_account.
WEB_OIDC_REAUTH_PROMPT=select_account
# Seconds a sign-in stays fresh before re-authentication. Default 300.
WEB_REAUTH_MAX_AGE_SEC=300
# Path of the dashboard sign-in database. Default .dashboard/auth.sqlite.
WEB_AUTH_DB=.dashboard/auth.sqlite
# Listen address. Default 127.0.0.1. Loopback only unless WEB_ALLOW_REMOTE_BIND=true.
WEB_BIND=127.0.0.1
# Allow a non-loopback listen address on purpose. Default false. Allowed: exactly true or false.
WEB_ALLOW_REMOTE_BIND=false
# Comma list of extra Host values (tunnel hostnames), hostname or host:port. Default unset.
WEB_ALLOWED_HOSTS=
# Trust forwarded headers from a reverse proxy. Default false. Allowed: exactly true or false.
# Set true only behind a trusted proxy.
WEB_TRUST_PROXY=false
# Enable the two-step dashboard chat send. Default false. Allowed: exactly true or false.
# Use a read_only permission set if you enable it.
WEB_CHAT_ENABLED=false

# =====================================================================================
# Telegram (ccgram bridge)
# =====================================================================================

# Bot token from @BotFather. Secret. Required for the Telegram bridge. Unset: the bridge does
# not start (the setup step can be skipped by choice).
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user ids allowed to talk to the bot, for example 123456789.
# Required together with TELEGRAM_BOT_TOKEN.
ALLOWED_USERS=
# Leave CCGRAM_WHISPER_*, CCGRAM_LLM_*, CCGRAM_TTS_* and CCGRAM_MINIAPP_* unset (they stay off).
# Never add a skip-permissions flag anywhere in this project.
# tmux session of the ccgram daemon. Default ccgram-daemon. Letters, digits, _ and -.
# CCGRAM_DAEMON_SESSION=ccgram-daemon
# tmux session of the manager windows. Default: the session in config/manager-windows.json
# (ccgram). Optional.
# MANAGER_TMUX_SESSION=ccgram

# =====================================================================================
# Layout memory (plan 8B)
# All optional. The values shown are the defaults. Invalid values fall back to the default.
# =====================================================================================

# off, warn or enforce. Default warn. enforce refuses typed sends on drift or unknown layouts;
# learn first (see CLAUDE.md, Layout memory).
# LAYOUT_ENFORCE=warn
# Observations before a layout variant is promoted, 1..1000. Default 3.
# LAYOUT_PROMOTE_N=3
# Distinct run ids needed for promotion, 1..1000. Default 2.
# LAYOUT_PROMOTE_RUNS=2
# Landmark score for a match, 0..1. Default 0.9.
# LAYOUT_MATCH_MIN=0.9
# Landmark score for a partial match, 0..1, not above the match value. Default 0.6.
# LAYOUT_PARTIAL_MIN=0.6
# Days before a learned kind counts as stale, 1..3650. Default 30.
# LAYOUT_STALE_DAYS=30
# Drift streak that writes an owner escalation, 1..1000. Default 3.
# LAYOUT_DRIFT_ESCALATE_N=3
# Drift streak that halts the platform (also needs 2 run ids, not below escalate), 1..1000.
# Default 5.
# LAYOUT_DRIFT_HALT_N=5
# Window for the drift streak, hours, 1..8760. Default 24.
# LAYOUT_DRIFT_WINDOW_HOURS=24
# Layout file size cap, bytes, 4096..1048576. Default 65536.
# LAYOUT_MAX_BYTES=65536
# Cap on the memory text shown to an operator, 100..20000. Default 1200.
# LAYOUT_RENDER_MAX_CHARS=1200
# Page text shorter than this counts as unloaded, 1..2000. Default 80.
# LAYOUT_UNLOADED_MAX_CHARS=80
# Parsed (0..100) but prompt-only: the operators' prompts state 6, it is not enforced. Default 6.
# LAYOUT_EXPLORE_BUDGET=6
# Layout store directory. Must resolve inside the project, otherwise the default is used.
# Default .jobber/layout.
# LAYOUT_DIR=.jobber/layout

# =====================================================================================
# Update and backup (plan 7D). See docs/backup-and-restore.md.
# =====================================================================================

# Git remote the update fetches from. Default origin. Use the upstream remote, not a fork you
# cannot trust.
AUTO_UPDATE_REMOTE=origin
# Branch the update fast-forwards to. Default main.
AUTO_UPDATE_BRANCH=main
# Optional tag glob (for example v*). Empty follows the branch tip.
AUTO_UPDATE_TAG_PATTERN=
# Require signed commits. Default true. Exactly false turns the signature check off (doctor warns).
AUTO_UPDATE_REQUIRE_SIGNED=true
# allowed_signers file with the maintainer SSH public keys. Required while signatures are required.
AUTO_UPDATE_SIGNERS_FILE=
# Comma list of paths that force a manual review. Empty keeps the built-in list.
AUTO_UPDATE_REVIEW_PATHS=
# Backup destination outside the project, ideally another disk (chmod 700). Required for backups.
BACKUP_DIR=
# age PUBLIC key (starts with age1) backups are encrypted to. Never a private key. Required for
# backups.
BACKUP_AGE_RECIPIENT=
# Also archive secrets/ (OAuth tokens, browser sessions). Default false. Allowed: true or false.
# See the runbook before enabling.
BACKUP_INCLUDE_SECRETS=false
# Optional rclone mirror, for example gdrive:jobber-backups. Empty: no mirror.
BACKUP_RCLONE_REMOTE=
# Daily archives kept. Default 7, integer 0..365.
BACKUP_RETAIN_DAILY=7
# Weekly archives kept. Default 4, integer 0..365.
BACKUP_RETAIN_WEEKLY=4
# Monthly archives kept. Default 6, integer 0..365.
BACKUP_RETAIN_MONTHLY=6

# =====================================================================================
# Advanced
# =====================================================================================

# Model routing for the claude CLI (see docs/model-auth-setup.md). Heaviest-tier model name.
# Claude Code itself reads it; Jobber code does not. Remove the line to use the default.
ANTHROPIC_DEFAULT_OPUS_MODEL=deepseek/deepseek-v4-pro
# Third-party endpoint, only with env-based auth. Do not run /login if you use it.
# ANTHROPIC_BASE_URL=
# API key sent to ANTHROPIC_BASE_URL. Secret.
# ANTHROPIC_AUTH_TOKEN=
# Main working model name for that endpoint.
# ANTHROPIC_DEFAULT_SONNET_MODEL=
# Small and fast subtask model name for that endpoint.
# ANTHROPIC_DEFAULT_HAIKU_MODEL=
# Path of the claude CLI used by the hybrid fallbacks. Default: claude (from PATH).
# CLAUDE_CLI_PATH=claude
# Model alias for npm run eval:gen and eval:judge. Default sonnet. A --model flag wins.
# EVAL_MODEL=sonnet
# Folder holding the personal data files (resume.json and others). Default user-data in the
# project. Relative paths resolve from the project root. Mode 700 is expected.
# JOBAPPLIER_USER_DATA=user-data
# tmux session holding the scheduler and web windows started by `npm run up`.
# Default jobber-stack.
# STACK_TMUX_SESSION=jobber-stack
# Seconds `npm run down` waits for the scheduler to finish its wake. Default 60, clamped 5..600.
# STACK_DOWN_WAIT_SEC=60
