HEADER

# =====================================================================================
# Web core (shared browser for company sites)
# =====================================================================================

# Fixture key FX_FLAG. Default false. Allowed: true or false.
FX_FLAG=false

# =====================================================================================
# Safety and dry-run flags
# JOBBER_DRY_RUN is the only dry-run flag. true = dry run, false or removed = LIVE. Only the owner flips it.
# =====================================================================================

# Fixture key FX_DRY_RUN. Default true. Allowed: true or false.
# FX_DRY_RUN=true
# Fixture key FX_ENABLE_SEND. Default false. Allowed: true or false.
# FX_ENABLE_SEND=false
# Fixture key FX_ONE_ONLY. Allowed: 1.
# FX_ONE_ONLY=

# =====================================================================================
# Advanced
# =====================================================================================

# Fixture key FX_ZERO_ONE. Default 0. Allowed: 0, 1.
# FX_ZERO_ONE=0

# =====================================================================================
# Limits (daily, weekly, per company, pacing, cooldowns)
# The full catalog with ranges is src/setup/limitsCatalog.ts; `npm run setup -- --step limits`
# edits it. Invalid values fall back to the default. Commented lines show the code default.
# =====================================================================================

# Fixture key FX_MAX_PER_DAY. Default 20. Integer 1..500.
# FX_MAX_PER_DAY=20
# Fixture key FX_MIN_GAP. Default 30. Integer 0..1440.
# FX_MIN_GAP=30

# =====================================================================================
# Scheduler
# =====================================================================================

# Fixture key PACING_MIN_BURST. Default 1. Integer 1..50.
# PACING_MIN_BURST=1
# Fixture key PACING_MAX_BURST. Default 4. Integer 1..50.
# PACING_MAX_BURST=4

# =====================================================================================
# Dashboard (npm run web)
# =====================================================================================

# Fixture key FX_PORT. Default 8787. Integer 1024..65535.
FX_PORT=8787

# =====================================================================================
# Web core (shared browser for company sites)
# =====================================================================================

# Fixture key FX_MODE. Default token. Allowed: token, oidc, google_desktop.
# FX_MODE=token

# =====================================================================================
# Layout memory (plan 8B)
# All optional. The values shown are the defaults. Invalid values fall back to the default.
# =====================================================================================

# Fixture key FX_LAYOUT_ENFORCE. Default warn. Allowed: off, warn, enforce.
# FX_LAYOUT_ENFORCE=warn

# =====================================================================================
# Generated job sources and search
# =====================================================================================

# Fixture key FX_NAME. Required when FX_FLAG is true.
# FX_NAME=

# =====================================================================================
# Advanced
# =====================================================================================

# Fixture key FX_DATA_DIR. Default .jobber/fx.
# FX_DATA_DIR=.jobber/fx

# =====================================================================================
# Dashboard (npm run web)
# =====================================================================================

# Fixture key FX_REDIRECT_URL.
# FX_REDIRECT_URL=
# Fixture key FX_ALLOWED_EMAIL. Required.
# FX_ALLOWED_EMAIL=

# =====================================================================================
# Safety and dry-run flags
# JOBBER_DRY_RUN is the only dry-run flag. true = dry run, false or removed = LIVE. Only the owner flips it.
# =====================================================================================

# Fixture key FX_ALLOWED_URLS.
# FX_ALLOWED_URLS=

# =====================================================================================
# Limits (daily, weekly, per company, pacing, cooldowns)
# The full catalog with ranges is src/setup/limitsCatalog.ts; `npm run setup -- --step limits`
# edits it. Invalid values fall back to the default. Commented lines show the code default.
# =====================================================================================

# Fixture key FX_CADENCE_GAPS_DAYS. Default 3,4,5,7.
# FX_CADENCE_GAPS_DAYS=3,4,5,7

# =====================================================================================
# Credentials: job sources
# =====================================================================================

# Fixture key FX_API_KEY. Secret.
# FX_API_KEY=

# =====================================================================================
# Telegram (ccgram bridge)
# =====================================================================================

# Fixture key FX_BOT_TOKEN. Secret.
# FX_BOT_TOKEN=

# =====================================================================================
# Credentials: Gmail (cold email send and reply reading)
# =====================================================================================

# Fixture key FX_OAUTH_SECRET. Secret.
# FX_OAUTH_SECRET=

# =====================================================================================
# Safety and dry-run flags
# JOBBER_DRY_RUN is the only dry-run flag. true = dry run, false or removed = LIVE. Only the owner flips it.
# =====================================================================================

# Fixture key FX_KILL. Default false. Allowed: true or false.
# FX_KILL=false

# =====================================================================================
# Browser apply
# =====================================================================================

# Fixture key FX_APPLY_LIMIT. Default 5. Integer 0..100.
# FX_APPLY_LIMIT=5

# =====================================================================================
